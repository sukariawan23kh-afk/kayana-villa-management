# ---------------------------------------------------------------------------
# Copy this file to .env (local) and fill in. For Netlify, set the same vars
# in the Netlify dashboard under Site settings → Environment variables.
# ---------------------------------------------------------------------------

# Database provider: "sqlite" for local dev, "postgresql" for Netlify/production
DATABASE_PROVIDER=sqlite
# Local SQLite file path (when sqlite) OR Postgres connection URL (when postgresql)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Admin CMS password (change in production!). Default: kayana2026
ADMIN_PASSWORD=kayana2026

# Secret used to sign the admin session cookie (use a long random string)
ADMIN_SECRET=kayana-cms-secret-local

# WhatsApp number (digits only, international format, no +)
KAYANA_WHATSAPP=6281234567890
KAYANA_WHATSAPP_DISPLAY=+62 812 3456 7890
KAYANA_EMAIL=hello@kayanavilla.com
